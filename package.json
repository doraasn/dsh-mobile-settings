{
  "name": "dsh-mobile-settings",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "把 dsh-mobile 的「移动访问」入口从侧栏移到设置页",
  "main": "lib/index.js",
  "exports": {
    './icon': './icon.svg',
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib/*.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
